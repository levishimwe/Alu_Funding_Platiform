# Copy to server/.env and fill in. Never commit the real .env.

# Aiven MySQL (TLS is required; CA certificate goes in server/certs/ca.pem)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL_CA=./certs/ca.pem

# App
JWT_SECRET=            # long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CLIENT_URL=http://localhost:5173
PORT=4000
STORAGE_DRIVER=local
ALUMNI_EMAIL_DOMAINS=alueducation.com,alustudent.com   # graduate registration only

# Email (Gmail SMTP needs a Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Seeded accounts (npm run seed). Required — the seed refuses to run without them.
# Passwords: at least 12 characters, including a letter and a number.
ADMIN_EMAIL=
ADMIN_PASSWORD=
STAFF1_EMAIL=
STAFF1_PASSWORD=
STAFF2_EMAIL=
STAFF2_PASSWORD=
# Optional display names for the seeded accounts
ADMIN_NAME=
STAFF1_NAME=
STAFF2_NAME=
